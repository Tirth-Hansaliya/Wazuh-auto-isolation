<group name="local,firewall,">
  <rule id="100263" level="10">
    <if_sid>530</if_sid>
    <regex type="pcre2">'ufw-state':\s*ENABLED=no</regex>
    <description>Firewall (ufw) is DISABLED.</description>
  </rule>
  <rule id="100264" level="3">
    <if_sid>530</if_sid>
    <regex type="pcre2">'ufw-state':\s*ENABLED=yes</regex>
    <description>Firewall (ufw) is ENABLED.</description>
  </rule>
</group>



<!-- ============ NOISE rule: hide VirusTotal free-API rate-limit error ============ -->
<group name="local,virustotal,">
  <rule id="100250" level="0">
    <if_sid>87101</if_sid>
    <description>VirusTotal rate limit reached (ignored).</description>
  </rule>
</group>